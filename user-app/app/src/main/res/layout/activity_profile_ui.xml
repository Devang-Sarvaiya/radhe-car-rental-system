                        android:textStyle="bold"
                        app:layout_constraintEnd_toEndOf="@+id/showProfilePic"
                        app:layout_constraintHorizontal_bias="0.491"
                        app:layout_constraintStart_toStartOf="@+id/showProfilePic"
                        app:layout_constraintTop_toBottomOf="@+id/showProfilePic" />


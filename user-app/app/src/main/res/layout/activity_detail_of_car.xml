<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/light_blue"
    tools:context=".Detail_Of_Car">

    <ScrollView
        android:id="@+id/scrollView2"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:layout_editor_absoluteX="3dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingBottom="8dp">

                <ImageView
                    android:id="@+id/imageView6"
                    android:layout_width="411dp"
                    android:layout_height="344dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/top_grey_background"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/constraintLayout3"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginStart="24dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginEnd="24dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageView
                        android:id="@+id/img_back"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:srcCompat="@drawable/back" />

                    <TextView
                        android:id="@+id/txt_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/roboto_bold"
                        android:text="Detail"
                        android:textColor="#000000"
                        android:textSize="24sp"
                        app:layout_constraintBottom_toBottomOf="@+id/img_back"
                        app:layout_constraintEnd_toStartOf="@+id/img_favourite"
                        app:layout_constraintStart_toEndOf="@+id/img_back"
                        app:layout_constraintTop_toTopOf="@+id/img_back" />

                    <ImageView
                        android:id="@+id/img_favourite"
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:srcCompat="@drawable/available" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.cardview.widget.CardView
                    android:id="@+id/cardview"
                    android:layout_width="370dp"
                    android:layout_height="250dp"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="20dp"
                    app:layout_constraintBottom_toBottomOf="@+id/imageView6"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/constraintLayout3">

                    <androidx.viewpager2.widget.ViewPager2
                        android:id="@+id/viewPagerImages"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />
                </androidx.cardview.widget.CardView>


            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp">

                <TextView
                    android:id="@+id/txtTitle"
                    style="@style/TEXT"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="1dp"
                    android:layout_marginEnd="372dp"
                    android:fontFamily="@font/nunito_black"
                    android:text="Title"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:layout_width="50dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="96dp"
                    android:elevation="3dp"
                    android:gravity="center|end"
                    android:text="Rs."
                    android:textColor="@color/wallet_holo_blue_light"
                    android:textSize="16dp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_bias="0.0" />

                <TextView
                    android:id="@+id/txtRent2"
                    android:layout_width="110dp"
                    android:layout_height="40dp"
                    android:elevation="3dp"
                    android:gravity="center"
                    android:text="Rs. 500"
                    android:textColor="@color/wallet_holo_blue_light"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.984"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
                <!--                android:background="@drawable/green_bg"-->

            </androidx.constraintlayout.widget.ConstraintLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"></LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="24dp"
                android:orientation="horizontal" />

            <TextView
                android:id="@+id/textView17"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/nunito_bold"
                android:text="Connected Driver"
                android:textColor="@color/black"
                android:textSize="20sp"
                android:textStyle="bold" />



            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginLeft="21dp"
                android:layout_marginTop="20dp"
                android:elevation="8dp"
                android:layout_marginRight="21dp"
                android:layout_weight="0.33"
                android:background="@drawable/white_background">

                <ImageView
                    android:id="@+id/img_renter"
                    android:layout_width="64dp"
                    android:layout_height="65dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="4dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:srcCompat="@drawable/lambo" />

                <TextView
                    android:id="@+id/txtrname"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:hint="Name"
                    android:textColor="#000000"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toEndOf="@+id/img_renter"
                    app:layout_constraintTop_toTopOf="@+id/img_renter" />

                <TextView
                    android:id="@+id/txtMob"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Renter"
                    android:textColor="#000000"
                    app:layout_constraintBottom_toBottomOf="@+id/img_renter"
                    app:layout_constraintStart_toStartOf="@+id/txtrname"
                    app:layout_constraintTop_toBottomOf="@+id/txtrname"
                    app:layout_constraintVertical_bias="0.666" />

            </androidx.constraintlayout.widget.ConstraintLayout>


            <TextView
                android:id="@+id/textView16"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/nunito_bold"
                android:text="Description"
                android:textColor="@color/black"
                android:textSize="20sp"
                android:textStyle="bold" />


            <TextView
                android:id="@+id/txtDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="24dp"
                android:inputType="textMultiLine"
                android:text="TextVvjkdwhbfhdjbvdhjbfdhjbfdhjfvdkhfbdhjfbvd
                bnjdfhihfk
                jbhfgiudghf
                snvbhjfgsyhgvd
                bfjhghjsdgfjhjkfgkjhbhjk
                jkbyhgfhjsdbjhb
                iew"
                android:textColor="@color/grey_font"
                android:textSize="16sp" />


            <LinearLayout
                android:id="@+id/linearLayout8"
                android:layout_width="match_parent"
                android:layout_height="190dp"
                android:layout_marginLeft="21dp"
                android:layout_marginTop="20dp"
                android:layout_marginRight="21dp"
                android:background="@drawable/white_background"
                android:elevation="3dp"
                android:orientation="horizontal"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/txtFuel">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:elevation="8dp"
                    android:layout_weight="0.33">

                    <TextView
                        android:id="@+id/textView13"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="24dp"
                        android:layout_marginTop="8dp"
                        android:fontFamily="@font/nunito_extrabold"
                        android:text="Car Info"
                        android:textColor="#000000"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <ImageView
                        android:id="@+id/img_passanger"
                        android:layout_width="26dp"
                        android:layout_height="30dp"
                        android:layout_marginStart="8dp"
                        android:layout_marginTop="16dp"
                        app:layout_constraintStart_toStartOf="@+id/textView13"
                        app:layout_constraintTop_toBottomOf="@+id/textView13"
                        app:srcCompat="@drawable/baseline_person_24" />

                    <TextView
                        android:id="@+id/txtPassengers"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="2 Passengers"
                        app:layout_constraintBottom_toBottomOf="@+id/img_passanger"
                        app:layout_constraintStart_toEndOf="@+id/img_passanger"
                        app:layout_constraintTop_toTopOf="@+id/img_passanger" />

                    <ImageView
                        android:id="@+id/img_airconditioning"
                        android:layout_width="26dp"
                        android:layout_height="30dp"
                        android:layout_marginTop="20dp"
                        app:layout_constraintStart_toStartOf="@+id/img_passanger"
                        app:layout_constraintTop_toBottomOf="@+id/img_passanger"
                        app:srcCompat="@drawable/air_conditioning" />

                    <TextView
                        android:id="@+id/txtRating"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Air Conditioning"
                        app:layout_constraintBottom_toBottomOf="@+id/img_airconditioning"
                        app:layout_constraintStart_toEndOf="@+id/img_airconditioning"
                        app:layout_constraintTop_toTopOf="@+id/img_airconditioning" />

                    <ImageView
                        android:id="@+id/img_manual"
                        android:layout_width="27dp"
                        android:layout_height="23dp"
                        android:layout_marginTop="20dp"
                        app:layout_constraintStart_toStartOf="@+id/img_airconditioning"
                        app:layout_constraintTop_toBottomOf="@+id/img_airconditioning"
                        app:srcCompat="@drawable/gear_stick" />

                    <TextView
                        android:id="@+id/txtgear"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Manuual"
                        app:layout_constraintBottom_toBottomOf="@+id/img_manual"
                        app:layout_constraintStart_toEndOf="@+id/img_manual"
                        app:layout_constraintTop_toTopOf="@+id/img_manual" />

                    <ImageView
                        android:id="@+id/img_door"
                        android:layout_width="26dp"
                        android:layout_height="30dp"
                        android:layout_marginStart="40dp"
                        app:layout_constraintBottom_toBottomOf="@+id/txtPassengers"
                        app:layout_constraintEnd_toEndOf="@+id/img_fuel"
                        app:layout_constraintStart_toEndOf="@+id/txtPassengers"
                        app:layout_constraintTop_toTopOf="@+id/txtPassengers"
                        app:srcCompat="@drawable/car_door" />

                    <TextView
                        android:id="@+id/txtdoor"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="2 Doors"
                        app:layout_constraintBottom_toBottomOf="@+id/img_door"
                        app:layout_constraintStart_toEndOf="@+id/img_door"
                        app:layout_constraintTop_toTopOf="@+id/img_door"
                        app:layout_constraintVertical_bias="0.222" />

                    <ImageView
                        android:id="@+id/img_fuel"
                        android:layout_width="26dp"
                        android:layout_height="30dp"
                        android:layout_marginStart="36dp"
                        app:layout_constraintBottom_toBottomOf="@+id/txtRating"
                        app:layout_constraintStart_toEndOf="@+id/txtRating"
                        app:layout_constraintTop_toTopOf="@+id/txtRating"
                        app:srcCompat="@drawable/fuel_station" />

                    <TextView
                        android:id="@+id/txtFuel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Full to Full"
                        app:layout_constraintBottom_toBottomOf="@+id/img_fuel"
                        app:layout_constraintStart_toEndOf="@+id/img_fuel"
                        app:layout_constraintTop_toTopOf="@+id/img_fuel"
                        app:layout_constraintVertical_bias="0.545" />


                </androidx.constraintlayout.widget.ConstraintLayout>


            </LinearLayout>

            <LinearLayout
                android:id="@+id/linearLayout10"
                android:layout_width="match_parent"
                android:layout_height="90dp"
                android:layout_marginLeft="21dp"
                android:layout_marginTop="20dp"
                android:layout_marginRight="21dp"
                android:background="@drawable/white_background"
                android:elevation="8dp"
                android:orientation="horizontal"
                app:layout_constraintBottom_toTopOf="@+id/button"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/linearLayout9">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="0.33">

                    <ImageView
                        android:id="@+id/imageView9"
                        android:layout_width="40dp"
                        android:layout_height="37dp"
                        android:layout_marginStart="16dp"
                        android:layout_marginTop="16dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:srcCompat="@drawable/speed"
                        tools:ignore="DuplicateIds" />

                    <TextView
                        android:id="@+id/txtMaxSpeed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="0"
                        android:textColor="@color/black"
                        android:textStyle="bold"
                        app:layout_constraintBottom_toBottomOf="@+id/imageView9"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintHorizontal_bias="0.0"
                        app:layout_constraintStart_toEndOf="@+id/imageView9"
                        app:layout_constraintTop_toTopOf="@+id/imageView9" />

                    <TextView
                        android:id="@+id/txtMob"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="8dp"
                        android:fontFamily="@font/dosis_semibold"
                        android:text="Max. Speed"
                        android:textColor="@color/black"
                        app:layout_constraintEnd_toEndOf="@+id/txtMaxSpeed"
                        app:layout_constraintStart_toStartOf="@+id/imageView9"
                        app:layout_constraintTop_toBottomOf="@+id/imageView9"
                        tools:ignore="DuplicateIds" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <View
                    android:id="@+id/view2"
                    android:layout_width="1dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="8dp"
                    android:background="@color/gray" />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="0.33">

                    <ImageView
                        android:id="@+id/imageView9"
                        android:layout_width="40dp"
                        android:layout_height="37dp"
                        android:layout_marginTop="16dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:srcCompat="@drawable/b_verify"
                        tools:ignore="DuplicateIds" />

                    <TextView
                        android:id="@+id/txt_verified"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="8dp"
                        android:fontFamily="@font/dosis_semibold"
                        android:text="Mph"
                        android:textColor="@color/black"
                        app:layout_constraintEnd_toEndOf="@+id/imageView9"
                        app:layout_constraintStart_toStartOf="@+id/imageView9"
                        app:layout_constraintTop_toBottomOf="@+id/imageView9"
                        tools:ignore="DuplicateIds,NotSibling" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <View
                    android:id="@+id/view2"
                    android:layout_width="1dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="8dp"
                    android:background="@color/gray"
                    tools:ignore="DuplicateIds" />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/Book_history"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="0.33">

                    <ImageView
                        android:id="@+id/imageView9"
                        android:layout_width="40dp"
                        android:layout_height="37dp"
                        android:layout_marginTop="16dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:srcCompat="@drawable/b_history"
                        tools:ignore="DuplicateIds" />

                    <TextView
                        android:id="@+id/txtMob"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="8dp"
                        android:fontFamily="@font/dosis_semibold"
                        android:text="Booking History"
                        android:textColor="@color/black"
                        app:layout_constraintEnd_toEndOf="@+id/imageView9"
                        app:layout_constraintStart_toStartOf="@+id/imageView9"
                        app:layout_constraintTop_toBottomOf="@+id/imageView9"
                        tools:ignore="DuplicateIds,NotSibling" />
                </androidx.constraintlayout.widget.ConstraintLayout>


            </LinearLayout>


            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/similerView"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginBottom="100dp"
                android:clipToPadding="false"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />


        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="78dp"
        android:background="@drawable/grey_background"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/textView19"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="@font/pangolin_regular"
            android:text="Rent per Day"
            android:textColor="@color/black"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/txtRent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginStart="24dp"
            android:fontFamily="@font/roboto_bold"
            android:gravity="center_horizontal"
            android:text=""
            android:textColor="@color/black"
            android:textSize="17sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@+id/textView19"
            app:layout_constraintEnd_toStartOf="@+id/textView19"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/textView19" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
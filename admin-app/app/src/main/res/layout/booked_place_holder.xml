<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="10dp"
    app:cardCornerRadius="10dp"
    app:cardElevation="10dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/imageView2"
            android:layout_width="30dp"
            android:layout_height="28dp"
            android:layout_marginTop="12dp"
            android:src="@drawable/calendar_1"
            app:layout_constraintEnd_toEndOf="@+id/imageView9"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="@+id/imageView9"
            app:layout_constraintTop_toBottomOf="@+id/imageView9" />

        <ImageView

            android:id="@+id/imageView3"
            android:layout_width="30dp"
            android:layout_height="28dp"
            android:layout_marginTop="8dp"
            android:src="@drawable/coin"
            app:layout_constraintEnd_toEndOf="@+id/imageView2"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="@+id/imageView2"
            app:layout_constraintTop_toBottomOf="@+id/imageView2" />

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/pic"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_marginLeft="15dp"
            android:adjustViewBounds="true"
            app:shapeAppearanceOverlay="@style/roundimageview2"
            android:elevation="8dp"
            android:background="@drawable/green_border"
            android:scaleType="centerCrop"
            android:src="@drawable/img"
            app:layout_constraintBottom_toBottomOf="@+id/imageView3"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/imageView8" />

        <ImageView
            android:id="@+id/imageView8"
            android:layout_width="30dp"
            android:layout_height="28dp"
            android:layout_marginStart="28dp"
            android:layout_marginTop="16dp"
            android:src="@drawable/car_book"
            app:layout_constraintStart_toEndOf="@+id/pic"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/imageView9"
            android:layout_width="30dp"
            android:layout_height="28dp"
            android:layout_marginTop="8dp"
            android:src="@drawable/calendar"
            app:layout_constraintEnd_toEndOf="@+id/imageView8"
            app:layout_constraintStart_toStartOf="@+id/imageView8"
            app:layout_constraintTop_toBottomOf="@+id/imageView8" />

        <TextView
            android:id="@+id/address"
            android:layout_width="187dp"
            android:layout_height="26dp"
            android:layout_marginStart="4dp"
            android:gravity="center_vertical"
            android:text="Address"
            android:textSize="23dp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@+id/imageView8"
            app:layout_constraintStart_toEndOf="@+id/imageView8"
            app:layout_constraintTop_toTopOf="@+id/imageView8" />

        <TextView
            android:id="@+id/start_date"
            android:layout_width="187dp"
            android:layout_height="26dp"
            android:layout_marginStart="5dp"
            android:gravity="center_vertical"
            android:text="00,000"
            android:textColor="#000000"
            android:textSize="23sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@+id/imageView9"
            app:layout_constraintStart_toEndOf="@+id/imageView9"
            app:layout_constraintTop_toTopOf="@+id/imageView9" />

        <TextView
            android:id="@+id/end_date"
            android:layout_width="187dp"
            android:layout_height="26dp"
            android:layout_marginStart="5dp"
            android:gravity="center_vertical"
            android:text="00,000"
            android:textColor="#000000"
            android:textSize="23sp"

            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@+id/imageView2"
            app:layout_constraintStart_toEndOf="@+id/imageView2"
            app:layout_constraintTop_toTopOf="@+id/imageView2" />

        <TextView
            android:id="@+id/price"
            android:layout_width="187dp"
            android:layout_height="26dp"
            android:layout_marginStart="5dp"
            android:gravity="center_vertical"
            android:text="00,000"
            android:textColor="#000000"
            android:textSize="23sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@+id/imageView3"
            app:layout_constraintStart_toEndOf="@+id/imageView3"
            app:layout_constraintTop_toTopOf="@+id/imageView3" />

        <TextView
            android:id="@+id/title_1"
            android:layout_width="match_parent"
            android:layout_height="35dp"
            android:layout_marginTop="25dp"
            android:background="@color/light_gray"
            android:gravity="center|left"
            android:paddingLeft="15dp"
            android:textColor="#000000"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/pic"
            tools:ignore="MissingConstraints" />

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="35dp"
            android:layout_marginStart="15dp"
            android:background="@color/light_gray"
            android:gravity="center|left"
            android:text="Title"
            android:textColor="#000000"
            android:textSize="20sp"

            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@+id/title_1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/pic"
            app:layout_constraintVertical_bias="1.0"
            tools:ignore="MissingConstraints" />


        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnRenterPayment"
            android:layout_width="150dp"
            android:layout_height="50dp"
            android:background="@drawable/lg_back_green"
            android:text="Pay Now to Renter"
            android:textColor="@color/white"
            app:layout_constraintBottom_toBottomOf="@+id/txtRenterPaymet"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/txtRenterPaymet"
            app:layout_constraintTop_toTopOf="@+id/txtRenterPaymet"
            app:layout_constraintVertical_bias="0.0" />

        <TextView
            android:id="@+id/txtRenttxt"
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            android:fontFamily="@font/roboto_bold"
            android:gravity="center"
            android:text="Payment to Renter :"
            android:textColor="@color/black"
            android:textSize="20sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.502"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/title_1" />

        <TextView
            android:id="@+id/txtRenterPaymet"
            android:layout_width="150dp"
            android:layout_height="50dp"
            android:layout_marginStart="40dp"
            android:backgroundTint="#FA0000"
            android:gravity="center"
            android:hint="Renters Payments"
            android:textColor="#FA0000"
            android:textSize="20dp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/txtRenttxt" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnPicupPayment"
            android:layout_width="150dp"
            android:layout_height="50dp"
            android:background="@drawable/lg_back_green"
            android:text="Pay Now to pickup point"
            android:textColor="@color/white"
            app:layout_constraintBottom_toBottomOf="@+id/txtPicupPayemet"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/txtPicupPayemet"
            app:layout_constraintTop_toTopOf="@+id/txtPicupPayemet"
            app:layout_constraintVertical_bias="0.0" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_driver"
            android:layout_width="150dp"
            android:layout_height="50dp"
            android:background="@drawable/lg_back_green"
            android:text="Pay Now to driver"
            android:textColor="@color/white"
            app:layout_constraintBottom_toBottomOf="@+id/txtdriver"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/txtdriver"
            app:layout_constraintTop_toTopOf="@+id/txtdriver"
            app:layout_constraintVertical_bias="0.0" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_User"
            android:layout_width="150dp"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/lg_back_green"
            android:textColor="@color/white"
            android:gravity="center"
            android:text="Pay Now to User"
            app:layout_constraintBottom_toBottomOf="@+id/txtUser"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/txtUser"
            app:layout_constraintTop_toTopOf="@+id/txtUser" />

        <TextView
            android:id="@+id/txtpictxt"
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/roboto_bold"
            android:gravity="center"
            android:text="Payment to Pickup Point :"
            android:textColor="@color/black"
            android:textSize="20sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.503"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/txtRenterPaymet" />

        <TextView
            android:id="@+id/txtPicupPayemet"
            android:layout_width="150dp"
            android:layout_height="50dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="#FA0000"
            android:gravity="center"
            android:hint="Pickup Points Payments"
            android:textColor="#FA0000"
            android:textSize="20dp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="@+id/txtRenterPaymet"
            app:layout_constraintHorizontal_bias="1.0"
            app:layout_constraintStart_toStartOf="@+id/txtpictxt"
            app:layout_constraintTop_toBottomOf="@+id/txtpictxt" />

        <TextView
            android:id="@+id/txtdrtxt"
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/roboto_bold"
            android:gravity="center"
            android:text="Payment to Driver:"
            android:textColor="@color/black"
            android:textSize="20sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/txtPicupPayemet" />

        <TextView
            android:id="@+id/txtdriver"
            android:layout_width="150dp"
            android:layout_height="50dp"
            android:backgroundTint="#FA0000"
            android:gravity="center"
            android:hint="Driver Payments"
            android:textColor="#FA0000"
            android:textSize="20dp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="@+id/txtPicupPayemet"
            app:layout_constraintTop_toBottomOf="@+id/txtdrtxt" />

        <TextView
            android:id="@+id/txtrefundtxt"
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            android:fontFamily="@font/roboto_bold"
            android:gravity="center"
            android:text="Refund :"
            android:textColor="@color/black"
            android:textSize="20sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/txtdriver" />

        <TextView
            android:id="@+id/txtUser"
            android:layout_width="150dp"
            android:layout_height="50dp"
            android:layout_marginStart="40dp"
            android:backgroundTint="#FA0000"
            android:gravity="center"
            android:hint="User Payments"
            android:textColor="#FA0000"
            android:textSize="20dp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/txtrefundtxt" />


    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>
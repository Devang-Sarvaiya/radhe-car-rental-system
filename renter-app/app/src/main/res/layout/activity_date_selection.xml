<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/light_green"
    tools:context=".For_new_Project.date_selection">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="450dp"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/topLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="20dp"
            android:layout_marginRight="20dp"
            android:orientation="horizontal">

            <!-- "Select Date" TextView -->
            <TextView
                android:id="@+id/txtModelName"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:fontFamily="@font/dastine_oramica"
                android:gravity="center"
                android:text="@string/select_date"
                android:textColor="@color/green"
                android:textSize="24sp" />

            <ImageView
                android:id="@+id/cancel_btn"
                android:layout_width="35dp"
                android:layout_height="50dp"
                android:src="@drawable/cancel" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/linearLayout9"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="20dp"
            android:layout_marginRight="20dp"
            android:background="@drawable/green_background"
            android:elevation="5dp"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/edt_start_date"
                android:layout_width="match_parent"
                android:layout_height="57dp"
                android:background="@drawable/custom_input"
                android:clickable="false"
                android:cursorVisible="false"
                android:drawableStart="@drawable/calendar_2"
                android:drawablePadding="12dp"
                android:ems="10"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:fontFamily="@font/dosis_bold"
                android:gravity="center|left"
                android:hint="@string/starting_date"
                android:inputType="text"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textSize="20sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/linearLayout10"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="20dp"
            android:layout_marginRight="20dp"
            android:background="@drawable/green_background"
            android:elevation="5dp"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/edt_end_date"
                android:layout_width="match_parent"
                android:layout_height="57dp"
                android:background="@drawable/custom_input"
                android:clickable="false"
                android:cursorVisible="false"
                android:drawableStart="@drawable/calendar_1"
                android:drawablePadding="12dp"
                android:ems="10"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:fontFamily="@font/dosis_bold"
                android:gravity="center|left"
                android:hint="Ending Date"
                android:inputType="text"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textSize="20sp" />
        </LinearLayout>


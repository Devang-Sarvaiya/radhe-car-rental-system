<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Payment.Main_Payment">


    <androidx.appcompat.widget.AppCompatButton

        android:id="@+id/button2"
        android:layout_width="160dp"
        android:layout_height="71dp"
        android:layout_marginBottom="120dp"
        android:text="Continue"
        android:textSize="24sp"
        android:textStyle="bold"
        android:background="@drawable/lg_back_btn"
        android:textColor="@color/white"
        android:visibility="visible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.497"
        app:layout_constraintStart_toStartOf="parent" />

    <LinearLayout
        android:id="@+id/drivers"
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/green_background"
        android:elevation="5dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toTopOf="@+id/button2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.33">


            <TextView
                android:id="@+id/dr_email"
                android:layout_width="100dp"
                android:layout_height="37dp"
                android:layout_marginStart="36dp"
                android:layout_marginTop="20dp"
                android:fontFamily="@font/prestigea"
                android:gravity="center|left"
                android:text="Price :"
                android:textColor="@color/black"
                android:textSize="21sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/txt_price"
                android:layout_width="80dp"
                android:layout_height="37dp"
                android:layout_marginTop="20dp"
                android:gravity="center|right"
                android:hint="0000"
                android:textSize="21sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.8"
                app:layout_constraintStart_toEndOf="@+id/dr_email"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/txtDriver"
                android:layout_width="80dp"
                android:layout_height="37dp"
                android:layout_marginTop="12dp"
                android:gravity="center|right"
                android:hint="5%"
                android:textSize="21sp"
                app:layout_constraintEnd_toEndOf="@+id/txt_price"
                app:layout_constraintHorizontal_bias="0.733"
                app:layout_constraintStart_toStartOf="@+id/txt_price"
                app:layout_constraintTop_toBottomOf="@+id/txt_price" />

            <TextView
                android:id="@+id/textView17"
                android:layout_width="185dp"
                android:layout_height="37dp"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/prestigea"
                android:gravity="center|left"
                android:text="Driver charges (5%)"
                android:textColor="@color/black"
                android:textSize="21sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="@+id/dr_email"
                app:layout_constraintTop_toBottomOf="@+id/dr_email" />

            <TextView
                android:id="@+id/txt_deposit"
                android:layout_width="80dp"
                android:layout_height="37dp"
                android:layout_marginTop="12dp"
                android:gravity="center|right"
                android:hint="0000"
                android:textSize="21sp"
                app:layout_constraintEnd_toEndOf="@+id/txtDriver"
                app:layout_constraintHorizontal_bias="1.0"
                app:layout_constraintStart_toStartOf="@+id/txtDriver"
                app:layout_constraintTop_toBottomOf="@+id/txtDriver" />

            <TextView
                android:id="@+id/txt_gst"
                android:layout_width="80dp"
                android:layout_height="37dp"
                android:layout_marginTop="12dp"
                android:gravity="center|right"
                android:hint="0000"
                android:textSize="21sp"
                app:layout_constraintEnd_toEndOf="@+id/txt_deposit"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toStartOf="@+id/txt_deposit"
                app:layout_constraintTop_toBottomOf="@+id/txt_deposit" />

            <TextView
                android:id="@+id/textView23"
                android:layout_width="100dp"
                android:layout_height="37dp"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/prestigea"
                android:gravity="center|left"
                android:text="Deposit"
                android:textColor="@color/black"
                android:textSize="21sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="@+id/textView17"
                app:layout_constraintTop_toBottomOf="@+id/textView17" />


            <TextView
                android:id="@+id/textV"
                android:layout_width="100dp"
                android:layout_height="37dp"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/prestigea"
                android:gravity="center|left"
                android:text="Gst 18%"
                android:textColor="@color/black"
                android:textSize="21sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="@+id/textView23"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toStartOf="@+id/textView23"
                app:layout_constraintTop_toBottomOf="@+id/textView23" />

            <TextView
                android:id="@+id/txt_amt"
                android:layout_width="90dp"
                android:layout_height="37dp"
                android:layout_marginTop="12dp"
                android:gravity="center|right"
                android:text="00000"
                android:textColor="@color/green"
                android:textSize="21sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="@+id/txt_gst"
                app:layout_constraintHorizontal_bias="1.0"
                app:layout_constraintStart_toStartOf="@+id/txt_gst"
                app:layout_constraintTop_toBottomOf="@+id/txt_gst" />

            <TextView
                android:id="@+id/textView24"
                android:layout_width="150dp"
                android:layout_height="37dp"
                android:fontFamily="@font/prestigea"
                android:gravity="center|left"
                android:text="Total Amount"
                android:textColor="@color/black"
                android:textSize="22sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="@+id/txt_amt"
                app:layout_constraintStart_toStartOf="@+id/textV"
                app:layout_constraintTop_toBottomOf="@+id/textV"
                app:layout_constraintVertical_bias="1.0" />

        </androidx.constraintlayout.widget.ConstraintLayout>


    </LinearLayout>

    <TextView
        android:id="@+id/textView21"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="108dp"
        android:text="Payment Informations"
        android:textSize="24dp"
        android:textColor="@color/green"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.558"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


</androidx.constraintlayout.widget.ConstraintLayout>